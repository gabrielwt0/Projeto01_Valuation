!data/raw/ticker_cvm_map.csv
!data/raw/ticker_cvm_falhas.csv
data/processed/*
!data/processed/.gitkeep

# Relatórios gerados
reports/*.pdf
reports/*.html

# Dado bruto não deveria morar em notebooks/ (deve ir em data/raw/)
notebooks/*.csv
notebooks/*.zip

# Ambiente / editor
.env
.vscode/
.DS_Store
