# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Dados brutos (baixados via API, não versionados)
data/raw/*
!data/raw/.gitkeep
# Exceção: mapeamento ticker -> CD_CVM já resolvido, para não depender
